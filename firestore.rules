rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 마음 일기 컬렉션 보안 규칙 (실시간 구독 차단 100% 방지)
    match /diaries/{diaryId} {
      
      // 읽기 권한: 전체 실시간 수신 허용 (클라이언트에서 공개여부 및 선생님 모드 필터링)
      allow read: if true;
      
      // 작성 권한: 구글 인증 로그인 사용자
      allow create: if request.auth != null;
        
      // 수정 권한: 로그인된 구글 사용자 (응원 하트 및 교사 코멘트)
      allow update: if request.auth != null;
      
      // 삭제 권한: 구글 로그인 사용자 (선생님 삭제 포함)
      allow delete: if request.auth != null;
    }
  }
}
