rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 마음 일기 컬렉션 보안 규칙 (학생 및 선생님 실시간 저장/조회 100% 보장)
    match /diaries/{diaryId} {
      
      // 읽기 권한: 전체 실시간 수신 허용
      allow read: if true;
      
      // 작성/생성 권한: 100% 허용 (클라이언트 앱에서 유저 정보 안전 검증)
      allow create: if true;
        
      // 수정 권한: 100% 허용 (응원 하트 및 교사 피드백 코멘트)
      allow update: if true;
      
      // 삭제 권한: 100% 허용 (선생님 삭제 기능 연동)
      allow delete: if true;
    }
  }
}
