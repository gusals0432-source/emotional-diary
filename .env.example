# Firebase Environment Variables Template for Vercel & Local Development
# Vercel 환경 변수 등록 시 아래 키 이름을 복사하여 사용하세요.

VITE_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=saettum-raon-diary.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=saettum-raon-diary
VITE_FIREBASE_STORAGE_BUCKET=saettum-raon-diary.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_MESSAGING_SENDER_ID
VITE_FIREBASE_APP_ID=YOUR_APP_ID
